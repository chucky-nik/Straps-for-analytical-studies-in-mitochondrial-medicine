# Neural Deep (основной LLM)
NEURAL_DEEP_API_KEY=your_neural_deep_key
NEURAL_DEEP_BASE_URL=https://api.neuraldeep.tech/v1
NEURAL_DEEP_MODEL=qwen3.8-27b-noreason

# llm7.io (запасной провайдер)
LLM7_API_KEY=your_llm7_key
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=codestral-latest

# NCBI E-utilities (рекомендуется указать email)
NCBI_EMAIL=researcher@example.com
NCBI_TOOL=mito_harness
# NCBI_API_KEY=  # опционально, повышает rate limit
